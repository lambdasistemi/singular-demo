# The Singular release this repository is pinned to: its macOS bundle feeds
# Formula/singular@<major.minor>.rb (homebrew/render.sh takes it as --singular-version/--singular-sha).
# `just bump vX.Y.Z` moves both lines to the new release with the flake pins.
SINGULAR_VERSION=1.1.0
SINGULAR_SHA=91ba2b5b05fd35dc7c348ac596274f1eaa463f74a54e2939b6f6f53fadd1460e
